#!/usr/bin/env python3
"""Apply/verify the /etc/grub.d patches this boot menu needs. Idempotent; safe to re-run.

Why a script: pacman restores these package-owned files on every grub upgrade, so the patches have
to be re-applied — /etc/pacman.d/hooks/31-efi-bootnext-off.hook calls `grub-menu-patches apply`
after grub updates, and one file means one place to read, test and fix.

Usage: grub-menu-patches [apply|verify]     (verify is the default)
Exit 0 = every patch is in place; 1 = something needs attention.
"""
import os
import pathlib
import sys

PATCHES = [
    (  # submenu marker, because GRUB draws no submenu indicator of its own
        "10_linux",
        'gettext_printf "Advanced options for %s" "${OS}"',
        'gettext_printf "Advanced options for %s  ▶" "${OS}"',
        "submenu marker on the Advanced row",
    ),
    (  # icon: gnu-linux.png/linux.png (Tux) — the row selects a kernel
        "10_linux",
        '"${OS}" | grub_quote)\' \\$menuentry_id_option',
        '"${OS}" | grub_quote)\' --class linux \\$menuentry_id_option',
        "--class linux on the Advanced submenu",
    ),
    (  # icon: efi.png (a gear)
        "30_uefi-firmware",
        "menuentry '$LABEL' \\$menuentry_id_option",
        "menuentry '$LABEL' --class efi \\$menuentry_id_option",
        "--class efi on the firmware entry",
    ),
    (  # icon: snapshots.png (clock, drawn by build-assets.sh)
        # The class MUST go on the OUTER submenu row — the one built from ${submenuname}, which is the
        # row the top-level menu shows. The inner per-snapshot submenu (${title_menu}) is a different
        # line inside grub-btrfs.cfg: patching that one makes `verify` say ok and renders no icon,
        # because the text landed on a row nobody sees.
        "41_snapshots-btrfs",
        "submenu '${submenuname}' ${protection_authorized_users}${unrestricted_access_submenu}{",
        "submenu '${submenuname}' --class snapshots "
        "${protection_authorized_users}${unrestricted_access_submenu}{",
        "--class snapshots on the snapshots submenu (outer row)",
    ),
]

# Patches from earlier revisions that must be UNDONE on trees that already have them. A patch table
# only grows otherwise, and a stray edit stays in /etc/grub.d forever.
RETIRED = [
    (  # targeted the inner submenu, so the visible row never got its icon
        "41_snapshots-btrfs",
        "submenu '${title_menu}' --class snapshots {",
        "submenu '${title_menu}' {",
        "class on the wrong (inner) snapshots submenu",
    ),
]

# GRUB_D is overridable so the patch logic can be tested against fixtures instead of the live tree.
GRUB_D = pathlib.Path(os.environ.get("GRUB_D", "/etc/grub.d"))


def main(mode: str) -> int:
    problems = 0
    for name, find, repl, why in PATCHES:
        path = GRUB_D / name
        if not path.exists():
            print(f"MISSING  {name:<20} {why}")
            problems += 1
            continue
        text = path.read_text()
        if repl in text:
            print(f"ok       {name:<20} {why}")
        elif find in text:
            if mode == "apply":
                path.write_text(text.replace(find, repl, 1))
                print(f"applied  {name:<20} {why}")
            else:
                print(f"MISSING  {name:<20} {why}")
                problems += 1
        else:
            # The upstream string moved — the patch silently no-ops, so say so loudly rather than
            # reporting success. The menu degrades cosmetically (no marker/icon on that row).
            print(f"CHANGED  {name:<20} {why} (upstream text not found — re-check the pattern)")
            problems += 1
    for name, unwanted, restore, why in RETIRED:
        path = GRUB_D / name
        if not path.exists():
            continue
        text = path.read_text()
        if unwanted in text:
            if mode == "apply":
                path.write_text(text.replace(unwanted, restore, 1))
                print(f"reverted {name:<20} {why}")
            else:
                print(f"STALE    {name:<20} {why} (run apply to remove it)")
                problems += 1
        else:
            print(f"ok       {name:<20} retired: {why}")
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1] if len(sys.argv) > 1 else "verify"))
